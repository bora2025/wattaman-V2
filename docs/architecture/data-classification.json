{
  "schemaVersion": 1,
  "status": "current-state",
  "checklistItem": "LC1-013",
  "source": "docs/architecture/data-classification.md (A-002)",
  "policy": [
    "Tiers and field judgements follow data-classification.md (A-002). This file makes them machine-checked and adds the lean-core categories: personal, child, financial, credential and location.",
    "A model is personal when it records identifiable people (it has a subject) or has a tier 2, 3, unbounded or inherits field. It is child data when a subject is a student, an applicant or any user account, because students have accounts and most students are minors. Financial, credential and location come from its classified fields.",
    "Every Prisma model is listed. A field whose name suggests sensitive data must be classified, or listed under `unflagged` with the reason it is not. A model holding student-linked records must come out as child data.",
    "Every outbound call and every external notification channel maps to a declared destination."
  ],
  "tiers": {
    "2": "Personal (PII): directly identifies a person.",
    "3": "Sensitive personal: financial, attendance or academic history tied to a named person, precise location, freeform notes.",
    "4": "Secret or credential: access material.",
    "unbounded": "Admin-configurable content whose sensitivity cannot be known from the schema.",
    "inherits": "A copy of whatever record it snapshots (audit before/after state).",
    "business": "Sensitive school business data that is not about an individual."
  },
  "categories": {
    "personal": "Identifies a person or describes an identifiable person.",
    "child": "Tied to a student, applicant or account that may belong to a minor.",
    "financial": "Money owed, paid or earned, by a person or by the school.",
    "credential": "Passwords, tokens, signed licence artifacts and scan or check-in codes.",
    "location": "Home addresses and precise positions."
  },
  "subjects": {
    "student": { "child": true, "description": "A student, presumed a minor." },
    "applicant": { "child": true, "description": "A prospective student applying through the public registration form." },
    "user": { "child": true, "description": "Any account holder. Student accounts are users, so this includes minors." },
    "guardian": { "child": false, "description": "A parent or guardian." },
    "staff": { "child": false, "description": "A teacher, administrator or other employee." }
  },
  "models": {
