{
  "schemaVersion": 1,
  "status": "proposed-until-lc0-decisions-are-accepted",
  "checklistItem": "LC1-011",
  "sources": [
    "docs/architecture/wattanam-lean-core-plugin-first-plan.md",
    "docs/architecture/module-to-plugin-migration-plan.md"
  ],
  "policy": [
    "Every discovered item resolves to exactly one future owner from `owners`. A mixed module names a split plan, and each of its items still resolves to one owner.",
    "Rules are ordered and the first match wins. There is no catch-all: a new backend area, page, route file or model with no rule is reported as a gap instead of silently becoming core.",
    "A `decision` reference marks an owner as provisional. It applies the plans' recommendation until that LC-0 or MP decision is accepted.",
    "A component or helper under frontend/components or frontend/lib with no rule takes the owner of the files importing it when they all agree; one shared across owners must be listed explicitly. A non-page file inside a route folder (loading.tsx, a page's own form) takes the owner of the nearest page at or above it.",
    "Records found inside a file (notifications, reports, file storage, API consumers, mobile calls) are owned by that file's owner. HTTP routes may override their file's owner through `routes`."
  ],
  "owners": {
    "lean-core": {
      "kind": "core",
      "scope": "Permanent platform foundation required by every school: installation, identity and access, plugin platform, operations and safety, commercial connection (lean-core plan section 6; migration plan section 3)."
    },
    "wattanam.academic-management": {
      "kind": "official-plugin",
      "scope": "Academic student profiles, admissions, classes, enrollment, study years, departments and subjects shared by dependent plugins.",
      "dependsOn": []
    },
    "wattanam.attendance": {
      "kind": "official-plugin",
      "scope": "Student school-day attendance: manual entry, camera/QR/card/USB scanning, corrections, sessions, holidays, card aliases, realtime status, alerts, reports and printing.",
      "dependsOn": ["wattanam.academic-management"]
    },
    "wattanam.timetable": {
      "kind": "official-plugin",
      "scope": "Subjects, classrooms, schedules, teacher schedules and timetable reports.",
      "dependsOn": ["wattanam.academic-management"]
    },
    "wattanam.examination": {
      "kind": "official-plugin",
      "scope": "Exams, questions, attempts, grades, score sheets, gradebook, reports and printing.",
      "dependsOn": ["wattanam.academic-management"]
    },
    "wattanam.learning": {
      "kind": "official-plugin",
      "scope": "Courses, lessons, assignments, quizzes, interactive content, course engagement and course-session attendance.",
      "dependsOn": ["wattanam.academic-management"]
    },
    "wattanam.communication": {
      "kind": "official-plugin",
      "scope": "Announcements, posts/news, direct messages, recipient rules, realtime delivery and channel fan-out.",
      "dependsOn": []
    },
    "wattanam.finance": {
      "kind": "official-plugin",
      "scope": "Student fees, discounts, payment records, receipts, school finance reports, budgets and accountant workflows.",
      "dependsOn": ["wattanam.academic-management"]
    },
    "wattanam.human-resources": {
      "kind": "official-plugin",
      "scope": "Employee profiles, CV, salary/payroll, staff attendance, staff reports and related print views.",
      "dependsOn": []
    },
    "wattanam.parent-portal": {
      "kind": "official-plugin",
      "scope": "Parent linking and requests, and parent-facing views composed from other plugins' contracts.",
      "dependsOn": [],
      "optionalDependsOn": ["wattanam.academic-management", "wattanam.attendance", "wattanam.finance", "wattanam.examination", "wattanam.transportation", "wattanam.communication"]
    },
    "wattanam.transportation": {
      "kind": "official-plugin",
      "scope": "Routes, stops, vehicles, assignments, driver workflows, live locations, parent tracking and transport reports.",
      "dependsOn": [],
      "optionalDependsOn": ["wattanam.academic-management"]
    },
    "wattanam.document-designer": {
      "kind": "official-plugin",
      "scope": "Student/staff cards, certificates, templates, QR assets, previews, bulk generation and print layouts.",
      "dependsOn": []
    },
    "wattanam.reporting": {
      "kind": "official-plugin",
      "scope": "Cross-feature dashboards and exports built only on published plugin read models (migration plan section 11).",
      "dependsOn": []
    },
    "platform-control-plane": {
      "kind": "central-service",
      "scope": "Marketplace API and Platform Admin: central Wattanam services, never installed in a school. Listed so their inventory records are owned, not so they migrate."
    }
  },
  "decisions": {
    "LC0-003": "Identity ownership. Recommended: core owns generic accounts, contacts and membership; Academic Management owns student/teacher academic profiles and classes; Human Resources owns employee profiles.",
    "LC0-011": "Communication scope. Whether Announcements (and Posts) become part of wattanam.communication or stay standalone plugins.",
    "LC0-012": "Attendance ownership. Recommended: staff attendance to Human Resources (migration plan 10.1); timetable teacher attendance to Attendance (migration plan section 4); course attendance to Learning (migration plan 10.1).",
    "MP1-002": "Whether the LaTeX editor belongs to Document Designer or to a separate Tool plugin."
  },
  "splitPlans": {
    "attendance-staff": {
      "area": "backend/src/attendance",
      "owners": ["wattanam.attendance", "wattanam.human-resources"],
      "decision": "LC0-012",
      "summary": "The module records both students and staff. Student school-day attendance stays with Attendance; staff recording, staff corrections and employee self-scan move to Human Resources, which may reuse an Attendance engine contract."
    },
    "auth-domain-profiles": {
      "area": "backend/src/auth",
      "owners": ["lean-core", "wattanam.timetable", "wattanam.parent-portal"],
      "decision": "LC0-003",
      "summary": "Authentication, sessions and generic account administration stay in core. Schedule lookups move to Timetable, and linking a student to a parent moves to Parent Portal. Student, teacher and employee profile data written through account routes is split out under LC0-003."
    },
    "notification-digests": {
      "area": "backend/src/notification-preference",
      "owners": ["lean-core", "wattanam.communication"],
      "decision": "LC0-011",
      "summary": "Preferences stay in core. The daily and weekly digests count unread messages and announcements, which is Communication business, so the digest service moves there (migration plan 5.1)."
    },
    "parent-messaging": {
      "area": "backend/src/parent",
      "owners": ["wattanam.communication", "wattanam.parent-portal"],
      "summary": "Direct messages (controller, service and realtime gateway) move to Communication. Parent linking and the parent's views of a child move to Parent Portal. The realtime transport itself stays core (migration plan 5.1)."
    },
    "reports-by-domain": {
      "area": "backend/src/reports",
      "owners": ["wattanam.attendance", "wattanam.human-resources", "lean-core", "wattanam.reporting", "wattanam.academic-management"],
      "decision": "LC0-012",
      "summary": "Each domain owns its reports (migration plan 5.3). Student attendance reports and exports go to Attendance; staff and employee attendance reports to Human Resources; system status and audit reads stay core; the cross-feature dashboard summary goes to Reporting; the duplicate-student check goes to Academic Management."
    },
    "session-config-staff": {
      "area": "backend/src/session-config",
      "owners": ["wattanam.attendance", "wattanam.human-resources"],
      "decision": "LC0-012",
      "summary": "Class session windows and attendance format rules stay with Attendance; staff session defaults and the staff weekly schedule move to Human Resources."
    },
    "timetable-teacher-attendance": {
      "area": "backend/src/timetable",
      "owners": ["wattanam.timetable", "wattanam.attendance"],
      "decision": "LC0-012",
      "summary": "Scheduling stays with Timetable. Teacher attendance against scheduled lessons (scan, mark and reports) goes to Attendance per migration plan section 4; LC0-012 may instead move it to Human Resources with the rest of staff attendance."
    },
    "mobile-scanner": {
      "area": "apps/mobile/src/screens/ScannerScreen.tsx",
      "owners": ["wattanam.attendance", "wattanam.human-resources"],
      "decision": "LC0-012",
      "summary": "One screen scans students and also lets an employee self-scan. Student scanning goes to Attendance; employee self-scan goes to Human Resources."
    }
  },
