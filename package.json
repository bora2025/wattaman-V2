{
  "name": "wattanam-v2",
  "version": "0.1.0",
  "private": true,
  "description": "A modernized school attendance system using QR codes.",
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "build:marketplace": "cd apps/marketplace-api && npm run build",
    "test:marketplace": "cd apps/marketplace-api && npm test",
    "provision:railway:school": "node tools/provision-railway-school.js",
    "domain:custom": "node tools/manage-custom-domain.js",
    "test:tools": "node --test tools/*.test.js",
    "architecture:inventory": "node tools/architecture-inventory.js --summary",
    "architecture:inventory:write": "node tools/architecture-inventory.js --write",
    "architecture:inventory:check": "node tools/architecture-inventory.js --check",
    "architecture:inventory:gate": "node tools/architecture-inventory.js --gate",
    "schema:core:write": "node tools/generate-core-prisma-schema.js --write",
    "schema:core:check": "node tools/generate-core-prisma-schema.js --check",
    "verify:control-plane": "node tools/verify-control-plane-config.js",
    "marketplace:publish:packages": "node tools/publish-plugin-packages.js",
    "marketplace:pack-and-publish": "node tools/pack-and-publish-plugins.js",
    "marketplace:check-publish-env": "node tools/check-marketplace-publish-env.js",
    "marketplace:bootstrap:catalog": "node tools/complete-plugin-catalog-bootstrap.js",
    "marketplace:fix-now": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/fix-marketplace-catalog.ps1",
    "test:tools:live": "node --test tools/*.live-test.js",
    "install:all": "cd backend && npm install && cd ../frontend && npm install && cd ../apps/mobile && npm install"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
