{
  "name": "wattanam-marketplace",
  "version": "0.1.0",
  "private": true,
  "description": "Wattanam marketplace control plane, platform administration, and official plugin workspace.",
  "scripts": {
    "install:all": "npm --prefix packages/marketplace-contracts install && npm --prefix packages/plugin-sdk install && npm --prefix packages/plugin-cli install && npm --prefix apps/marketplace-api install && npm --prefix apps/platform-admin install",
    "build": "npm run build:contracts && npm run build:sdk && npm run build:marketplace && npm run build:admin",
    "build:contracts": "npm --prefix packages/marketplace-contracts test",
    "build:sdk": "npm --prefix packages/plugin-sdk run build",
    "build:marketplace": "npm --prefix apps/marketplace-api run build",
    "build:admin": "npm --prefix apps/platform-admin run build",
    "test": "npm run test:contracts && npm run test:sdk && npm run test:cli && npm run test:marketplace && npm run test:tools",
    "test:contracts": "npm --prefix packages/marketplace-contracts test",
    "test:sdk": "npm --prefix packages/plugin-sdk test -- --runInBand",
    "test:cli": "npm --prefix packages/plugin-cli test -- --runInBand",
    "test:marketplace": "npm --prefix apps/marketplace-api test",
    "test:tools": "node --test tools/*.test.js",
    "preplugins:check:universal": "npm run build:sdk",
    "plugins:check:universal": "node tools/check-universal-plugin-catalog.js",
    "test:official-plugins": "node apps/marketplace-api/node_modules/jest/bin/jest.js --config tools/official-plugin-jest.config.js --runInBand && node --test plugins/*/tests/*.test.js",
    "verify:control-plane": "node tools/verify-control-plane-config.js",
    "marketplace:publish:packages": "node tools/publish-plugin-packages.js",
    "marketplace:pack-and-publish": "node tools/pack-and-publish-plugins.js",
    "marketplace:check-publish-env": "node tools/check-marketplace-publish-env.js",
    "marketplace:bootstrap:catalog": "node tools/complete-plugin-catalog-bootstrap.js",
    "marketplace:fix-now": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/fix-marketplace-catalog.ps1"
  },
  "license": "ISC"
}
