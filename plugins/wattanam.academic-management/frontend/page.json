            { "id": "generationMode", "type": "select", "label": "Generation", "required": true, "options": [{ "label": "Required", "value": "REQUIRED" }, { "label": "Optional", "value": "OPTIONAL" }, { "label": "Hidden", "value": "HIDDEN" }] }
