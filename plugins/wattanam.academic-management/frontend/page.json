        { "id": "department-create-form", "type": "form", "title": "Create department", "source": "createDepartment", "fields": [
          { "id": "name", "type": "text", "label": "Name", "required": true, "minLength": 1, "maxLength": 120 },
          { "id": "nameKh", "type": "text", "label": "Khmer name", "maxLength": 120 },
          { "id": "description", "type": "textarea", "label": "Description", "maxLength": 2000 }
        ], "options": { "submitLabel": "Create", "successMessage": "Department created" } }
      ]
    },
    {
      "id": "department-edit",
      "title": "Edit Department",
      "routePath": "departments/edit/:id",
      "permission": "wattanam.academic-management.manage",
      "parameters": [{ "name": "id", "type": "string", "maximumLength": 64 }],
      "dataSources": [
        { "id": "department", "method": "GET", "path": "departments/:id", "permission": "wattanam.academic-management.view" },
        { "id": "saveDepartment", "method": "PUT", "path": "departments/:id", "permission": "wattanam.academic-management.manage" }
