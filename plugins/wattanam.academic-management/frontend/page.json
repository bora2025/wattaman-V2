            { "id": "studentNumber", "type": "text", "label": "Student number", "maxLength": 80 },
            { "id": "sex", "type": "select", "label": "Sex", "options": [
              { "label": "Not specified", "value": "" },
              { "label": "Male", "value": "MALE" },
              { "label": "Female", "value": "FEMALE" },
              { "label": "Other", "value": "OTHER" }
            ] },
            { "id": "dateOfBirth", "type": "date", "label": "Date of birth" },
            { "id": "address", "type": "textarea", "label": "Address", "maxLength": 1000 },
            { "id": "generation", "type": "text", "label": "Generation", "maxLength": 120 },
            { "id": "photo", "type": "text", "label": "Photo URL", "maxLength": 500 },
            { "id": "parentId", "type": "text", "label": "Parent user ID", "maxLength": 36 },
            { "id": "customFieldValues", "type": "json", "label": "Custom fields" }
          ],
          "options": { "initialSource": "student", "submitLabel": "Save student", "successMessage": "Student updated" }
        }
      ]
    },
