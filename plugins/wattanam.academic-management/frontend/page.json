          "options": { "initialSource": "class", "submitLabel": "Save", "successMessage": "Class saved" }
        }
      ]
    },
    {
      "id": "class-students",
      "title": "Class Students",
      "routePath": "classes/:id/students",
      "permission": "wattanam.academic-management.view",
      "parameters": [{ "name": "id", "type": "uuid", "maximumLength": 36 }],
      "dataSources": [
        { "id": "class", "method": "GET", "path": "classes/:id", "permission": "wattanam.academic-management.view" },
        { "id": "students", "method": "GET", "path": "classes/:id/students", "permission": "wattanam.academic-management.view" },
        { "id": "addStudent", "method": "POST", "path": "classes/:id/students", "permission": "wattanam.academic-management.manage" },
        { "id": "removeStudent", "method": "DELETE", "path": "classes/:id/students/:studentId", "parameters": ["studentId"], "autoload": false, "permission": "wattanam.academic-management.manage" },
        { "id": "cleanupOrphanedStudents", "method": "POST", "path": "classes/cleanup-orphaned-students", "permission": "wattanam.academic-management.manage" }
      ],
      "components": [
        { "id": "heading", "type": "heading", "title": "Class Students" },
        {
          "id": "class-students-table",
          "type": "table",
          "title": "Students",
          "source": "students",
          "fields": [
            { "id": "studentNumber", "label": "Student number", "sortable": true },
            { "id": "user.name", "label": "Name", "path": "user.name" },
            { "id": "user.email", "label": "Email", "path": "user.email" },
            { "id": "user.phone", "label": "Phone", "path": "user.phone" },
            { "id": "nameKh", "label": "Khmer name" }
          ],
          "options": {
            "pageSize": 20,
            "selectable": true,
            "rowRoute": "classes/:id/students/:studentId",
            "rowParameterMap": { "studentId": "id" }
          }
        },
        {
          "id": "student-actions",
          "type": "actions",
          "options": {
            "actions": [
              {
                "id": "remove-selected-students",
                "label": "Remove selected students",
                "mode": "bulk",
                "source": "removeStudent",
                "selectionSource": "students",
                "idParameter": "studentId",
                "confirmation": "End the selected students' current class enrollments? Their profiles, accounts, and history will be preserved.",
                "destructive": true
              },
              {
                "id": "cleanup-orphaned-students",
                "label": "Clean up orphaned students",
                "mode": "single",
                "source": "cleanupOrphanedStudents",
                "confirmation": "Delete plugin profiles that have never had an enrollment? Core accounts are preserved.",
                "destructive": true
              }
            ]
          }
        },
        {
          "id": "add-student-form",
          "type": "form",
          "title": "Add student to class",
          "source": "addStudent",
          "fields": [
            { "id": "studentId", "type": "text", "label": "Student user ID", "required": true, "maxLength": 36 }
          ],
          "options": { "submitLabel": "Add", "successMessage": "Student added" }
        }
      ]
    },
