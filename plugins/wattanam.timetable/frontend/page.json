{
  "schemaVersion": 2,
  "kind": "declarative-ui",
  "pages": [
    {
      "id": "timetables",
      "title": "Timetables",
      "routePath": "timetables",
      "permission": "wattanam.timetable.view",
      "parameters": [],
      "dataSources": [
        { "id": "list", "method": "GET", "path": "timetables", "permission": "wattanam.timetable.view" },
        { "id": "create", "method": "POST", "path": "timetables", "permission": "wattanam.timetable.manage" }
      ],
      "components": [
        { "id": "heading", "type": "heading", "title": "Timetable" },
        { "id": "list", "type": "table", "title": "Timetable documents", "source": "list", "fields": [
          { "id": "name", "label": "Name", "sortable": true },
          { "id": "academicYear", "label": "Academic year" },
          { "id": "periodsPerDay", "label": "Periods per day" },
          { "id": "numberOfDays", "label": "Days per week" },
          { "id": "status", "label": "Status" }
        ], "options": { "pageSize": 25, "selectable": false } },
        { "id": "create-form", "type": "form", "title": "Create timetable", "source": "create", "fields": [
          { "id": "name", "type": "text", "label": "Name", "required": true },
          { "id": "short", "type": "text", "label": "Short name" },
          { "id": "academicYear", "type": "text", "label": "Academic year", "required": true },
          { "id": "periodsPerDay", "type": "number", "label": "Periods per day", "required": true, "min": 1, "max": 24 },
          { "id": "numberOfDays", "type": "number", "label": "Days per week", "required": true, "min": 1, "max": 7 }
        ], "options": { "submitLabel": "Create", "successMessage": "Timetable created" } }
      ]
    },
    {
      "id": "subjects", "title": "Timetable Subjects", "routePath": "subjects", "permission": "wattanam.timetable.view", "parameters": [],
