          { "id": "name", "type": "text", "label": "Name", "required": true }, { "id": "short", "type": "text", "label": "Short", "required": true },
          { "id": "color", "type": "text", "label": "Color" }
        ], "options": { "submitLabel": "Add subject", "successMessage": "Subject added" } }
