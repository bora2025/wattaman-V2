{
  "schemaVersion": 2,
  "kind": "declarative-ui",
  "portability": "universal",
  "pages": [
    {
      "id": "exams",
      "title": "Examinations",
      "routePath": "exams",
      "permission": "wattanam.examination.exams.view",
      "parameters": [],
      "dataSources": [],
      "components": [
        {
          "id": "exams-screen",
          "type": "app",
          "title": "Examinations",
          "options": {
            "entry": "ui/exams/index.html",
            "height": "auto",
            "minHeight": 600
          }
        }
      ]
    },
    {
      "id": "exam-new",
      "title": "Create exam",
      "routePath": "exams/new",
      "permission": "wattanam.examination.exams.manage",
      "parameters": [],
      "dataSources": [],
      "components": [
        {
          "id": "editor-screen",
          "type": "app",
          "title": "Create exam",
          "options": {
            "entry": "ui/editor/index.html",
            "height": "auto",
            "minHeight": 900,
            "devices": [
              "speech"
            ],
            "apis": [
              "wattanam.academic-management"
            ]
          }
        }
      ]
    },
    {
      "id": "exam-edit",
      "title": "Edit exam",
      "routePath": "exams/:id/edit",
      "permission": "wattanam.examination.exams.manage",
      "parameters": [
        {
          "name": "id",
          "type": "string",
          "maximumLength": 100
        }
      ],
      "dataSources": [],
      "components": [
        {
          "id": "editor-screen",
          "type": "app",
          "title": "Edit exam",
          "options": {
            "entry": "ui/editor/index.html",
            "height": "auto",
            "minHeight": 900,
            "devices": [
              "speech"
            ],
            "apis": [
              "wattanam.academic-management"
            ]
          }
        }
      ]
    },
    {
      "id": "exam-attempts",
      "title": "Gradebook",
      "routePath": "exams/:id/attempts",
      "permission": "wattanam.examination.attempts.grade",
      "parameters": [
        {
          "name": "id",
          "type": "string",
          "maximumLength": 100
        }
      ],
      "dataSources": [],
      "components": [
        {
          "id": "gradebook-screen",
          "type": "app",
          "title": "Gradebook",
          "options": {
            "entry": "ui/gradebook/index.html",
            "height": "auto",
            "minHeight": 600
          }
        }
      ]
    },
    {
      "id": "my-exams",
      "title": "My Exams",
      "routePath": "my-exams",
      "permission": "wattanam.examination.attempts.take",
      "parameters": [],
      "dataSources": [],
      "components": [
        {
          "id": "my-exams-screen",
          "type": "app",
          "title": "My Exams",
          "options": {
            "entry": "ui/my-exams/index.html",
            "height": "auto",
            "minHeight": 600
          }
        }
      ]
    },
    {
      "id": "take-exam",
      "title": "Exam",
      "routePath": "my-exams/:id",
      "permission": "wattanam.examination.attempts.take",
      "parameters": [
        {
          "name": "id",
          "type": "string",
          "maximumLength": 100
        }
      ],
      "dataSources": [],
      "components": [
        {
          "id": "take-screen",
          "type": "app",
          "title": "Exam",
          "options": {
            "entry": "ui/take/index.html",
            "height": "fill",
            "minHeight": 520,
            "devices": [
              "speech",
              "storage"
            ]
          }
        }
      ]
    },
    {
      "id": "my-results",
      "title": "My Results",
      "routePath": "my-results",
      "permission": "wattanam.examination.attempts.take",
      "parameters": [],
      "dataSources": [],
      "components": [
        {
          "id": "results-screen",
          "type": "app",
          "title": "My Results",
          "options": {
            "entry": "ui/results/index.html",
            "height": "auto",
            "minHeight": 400
          }
        }
      ]
    },
    {
      "id": "gradebooks",
      "title": "Gradebooks",
      "routePath": "gradebooks",
      "permission": "wattanam.examination.gradebook.view",
      "parameters": [],
      "dataSources": [
        {
          "id": "list",
          "method": "GET",
          "path": "gradebooks",
          "permission": "wattanam.examination.gradebook.view"
        }
      ],
      "components": [
        {
          "id": "heading",
          "type": "heading",
          "title": "Gradebooks"
        },
        {
          "id": "list",
          "type": "table",
          "title": "Score sheets",
          "source": "list",
          "fields": [
            {
              "id": "name",
              "label": "Name"
            },
            {
              "id": "degree",
              "label": "Degree"
            },
            {
              "id": "studyYearId",
              "label": "Study year"
            }
          ],
          "options": {
            "pageSize": 25,
            "selectable": false,
            "rowRoute": "gradebooks/:id/report",
            "rowParameterMap": {
              "id": "id"
            }
          }
        }
      ]
    },
    {
      "id": "gradebook-report",
      "title": "Gradebook report",
      "routePath": "gradebooks/:id/report",
      "permission": "wattanam.examination.gradebook.view",
      "parameters": [
        {
          "name": "id",
          "type": "string",
          "maximumLength": 100
        }
      ],
      "dataSources": [
        {
          "id": "report",
          "method": "GET",
          "path": "gradebooks/:id/report",
          "permission": "wattanam.examination.gradebook.view"
        }
      ],
      "components": [
        {
          "id": "heading",
          "type": "heading",
          "title": "Gradebook report"
        },
        {
          "id": "summary",
          "type": "detail",
          "title": "Gradebook",
          "source": "report",
          "fields": [
            {
              "label": "Name",
              "path": "gradebook.name"
            },
            {
              "label": "Degree",
              "path": "gradebook.degree"
            },
            {
              "label": "Study year",
              "path": "gradebook.studyYearId"
            }
          ]
        },
        {
          "id": "print-report",
          "type": "print",
          "title": "Student scores",
          "source": "report",
          "fields": [
            {
              "label": "Student",
              "path": "studentName"
            },
            {
              "label": "Class",
              "path": "className"
            },
            {
              "label": "Period",
              "path": "period"
            },
            {
              "label": "Subject",
              "path": "subject"
            },
            {
              "label": "Score",
              "path": "score"
            },
            {
              "label": "Maximum",
              "path": "maximumScore"
            }
          ],
          "options": {
            "itemsPath": "reportRows",
            "formats": [
              "print",
              "csv",
              "pdf"
            ],
            "filename": "gradebook-report",
            "maximumRows": 10000
          }
        }
      ]
    }
  ]
}
