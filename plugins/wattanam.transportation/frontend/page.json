{
  "schemaVersion": 2,
  "kind": "declarative-ui",
  "portability": "universal",
  "pages": [
    {
      "id": "vehicles",
      "title": "Transportation",
      "routePath": "vehicles",
      "permission": "wattanam.transportation.view",
      "parameters": [],
      "dataSources": [
        {
          "id": "list",
          "method": "GET",
          "path": "vehicles",
          "permission": "wattanam.transportation.view"
        },
        {
          "id": "create",
          "method": "POST",
          "path": "vehicles",
          "permission": "wattanam.transportation.manage"
        }
      ],
      "components": [
        {
          "id": "list",
          "type": "table",
          "title": "Vehicles",
          "source": "list",
          "fields": [
            { "id": "name", "label": "Name" },
            { "id": "plateNumber", "label": "Plate" },
            { "id": "capacity", "label": "Capacity" },
            { "id": "status", "label": "Status" },
            { "id": "routeName", "label": "Route" }
          ],
          "options": {
            "pageSize": 50,
            "selectable": false,
            "rowRoute": "vehicles/:id",
            "rowParameterMap": { "id": "id" }
          }
        },
        {
          "id": "create",
          "type": "form",
          "title": "Add vehicle",
          "source": "create",
          "fields": [
            { "id": "name", "type": "text", "label": "Name", "required": true },
            {
              "id": "plateNumber",
              "type": "text",
              "label": "Plate number",
              "required": true
            },
            {
              "id": "capacity",
              "type": "number",
              "label": "Capacity",
              "required": true,
              "min": 1,
              "max": 500
            },
            {
              "id": "status",
              "type": "select",
              "label": "Status",
              "required": true,
              "options": [
                { "label": "Active", "value": "ACTIVE" },
                { "label": "Inactive", "value": "INACTIVE" },
                { "label": "Maintenance", "value": "MAINTENANCE" }
              ]
            },
            {
              "id": "driverDirectoryUserId",
              "type": "text",
              "label": "Driver directory user ID"
            },
            { "id": "routeId", "type": "text", "label": "Route ID" }
          ],
          "options": {
            "submitLabel": "Add vehicle",
            "successMessage": "Vehicle added"
          }
        }
      ]
    },
    {
      "id": "routes",
      "title": "Transport routes",
      "routePath": "routes",
      "permission": "wattanam.transportation.manage",
      "parameters": [],
      "dataSources": [
        {
          "id": "list",
          "method": "GET",
          "path": "routes",
          "permission": "wattanam.transportation.view"
        },
        {
          "id": "create",
          "method": "POST",
          "path": "routes",
          "permission": "wattanam.transportation.manage"
        }
      ],
      "components": [
        {
          "id": "list",
          "type": "table",
          "title": "Routes",
          "source": "list",
          "fields": [
            { "id": "name", "label": "Name" },
            { "id": "description", "label": "Description" },
            { "id": "stopCount", "label": "Stops" }
          ],
          "options": { "pageSize": 50, "selectable": false }
        },
        {
          "id": "create",
          "type": "form",
          "title": "Add route",
          "source": "create",
          "fields": [
            { "id": "name", "type": "text", "label": "Name", "required": true },
            { "id": "description", "type": "textarea", "label": "Description" }
          ],
          "options": {
            "submitLabel": "Add route",
            "successMessage": "Route added"
          }
        }
      ]
    },
    {
      "id": "vehicle",
      "title": "Vehicle tracking",
      "routePath": "vehicles/:id",
      "permission": "wattanam.transportation.view",
      "parameters": [{ "name": "id", "type": "string", "maximumLength": 100 }],
      "dataSources": [
        {
          "id": "vehicle",
          "method": "GET",
          "path": "vehicles/:id",
          "permission": "wattanam.transportation.view"
        },
        {
          "id": "location",
          "method": "GET",
          "path": "vehicles/:id/location",
          "permission": "wattanam.transportation.view"
        },
        {
          "id": "history",
          "method": "GET",
          "path": "vehicles/:id/history",
          "permission": "wattanam.transportation.manage"
        }
      ],
      "components": [
        {
          "id": "vehicle",
          "type": "detail",
          "title": "Vehicle",
          "source": "vehicle",
          "fields": [
            { "label": "Name", "path": "name" },
            { "label": "Plate", "path": "plateNumber" },
            { "label": "Status", "path": "status" },
            { "label": "Route", "path": "routeName" }
          ]
        },
        {
          "id": "location",
          "type": "detail",
          "title": "Latest location",
          "source": "location",
          "fields": [
            { "label": "Latitude", "path": "latitude" },
            { "label": "Longitude", "path": "longitude" },
            { "label": "Speed", "path": "speed" },
            { "label": "Updated", "path": "timestamp", "format": "datetime" }
          ]
        },
        {
          "id": "history",
          "type": "table",
          "title": "Location history",
          "source": "history",
          "fields": [
            { "id": "timestamp", "label": "Time", "format": "datetime" },
            { "id": "latitude", "label": "Latitude" },
            { "id": "longitude", "label": "Longitude" },
            { "id": "speed", "label": "Speed" },
            { "id": "heading", "label": "Heading" }
          ],
          "options": { "pageSize": 100, "selectable": false }
        }
      ]
    },
    {
      "id": "parent-vehicles",
      "title": "Child transportation",
      "routePath": "parent/vehicles",
      "permission": "wattanam.transportation.parent.track",
      "parameters": [],
      "dataSources": [
        {
          "id": "list",
          "method": "GET",
          "path": "parent/vehicles",
          "permission": "wattanam.transportation.parent.track"
        }
      ],
      "components": [
        {
          "id": "notice",
          "type": "text",
          "title": "Only active vehicles assigned to your linked children are shown."
        },
        {
          "id": "list",
          "type": "table",
          "title": "Assigned vehicles",
          "source": "list",
          "fields": [
            { "id": "academicStudentId", "label": "Academic student" },
            { "id": "name", "label": "Vehicle" },
            { "id": "plateNumber", "label": "Plate" },
            { "id": "routeName", "label": "Route" },
            { "id": "latitude", "label": "Latitude" },
            { "id": "longitude", "label": "Longitude" },
            {
              "id": "timestamp",
              "label": "Location time",
              "format": "datetime"
            }
          ],
          "options": { "pageSize": 50, "selectable": false }
        }
      ]
    }
  ]
}
