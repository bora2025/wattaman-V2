{
  "schemaVersion": 2, "kind": "declarative-ui", "portability": "universal",
  "pages": [
    {
      "id": "templates", "title": "Document Designer", "routePath": "templates", "permission": "wattanam.document-designer.view", "parameters": [],
      "dataSources": [
        { "id": "templates", "method": "GET", "path": "templates", "permission": "wattanam.document-designer.view" },
        { "id": "create", "method": "POST", "path": "templates", "permission": "wattanam.document-designer.edit" },
        { "id": "assets", "method": "GET", "path": "assets", "permission": "wattanam.document-designer.view" },
        { "id": "asset-upload", "method": "POST", "path": "assets", "permission": "wattanam.document-designer.edit" },
        { "id": "asset-download", "method": "GET", "path": "assets/:assetId", "permission": "wattanam.document-designer.view", "parameters": ["assetId"], "autoload": false },
        { "id": "asset-delete", "method": "DELETE", "path": "assets/:assetId", "permission": "wattanam.document-designer.edit", "parameters": ["assetId"], "autoload": false }
      ],
      "components": [
        { "id": "heading", "type": "heading", "title": "Document templates" },
        { "id": "templates-table", "type": "table", "title": "Templates", "source": "templates", "fields": [
          { "id": "name", "label": "Name", "sortable": true, "filterable": true },
          { "id": "documentType", "label": "Document type", "sortable": true, "filterable": true },
          { "id": "isActive", "label": "Active", "format": "boolean", "sortable": true },
          { "id": "updatedAt", "label": "Updated", "format": "datetime", "sortable": true }
        ], "options": { "pageSize": 20, "selectable": false, "rowRoute": "templates/edit/:id", "rowParameterMap": { "id": "id" } } },
        { "id": "create-form", "type": "form", "title": "Create template", "source": "create", "fields": [
          { "id": "name", "type": "text", "label": "Name", "required": true, "minLength": 1, "maxLength": 120 },
          { "id": "documentType", "type": "text", "label": "Document type", "required": true, "minLength": 1, "maxLength": 40 }
        ], "options": { "submitLabel": "Create", "successMessage": "Template created" } },
        { "id": "asset-files", "type": "file", "title": "Template assets", "source": "assets", "options": {
          "uploadSource": "asset-upload", "downloadSource": "asset-download", "deleteSource": "asset-delete",
          "idParameter": "assetId", "maxBytes": 1048576, "acceptedTypes": ["image/png", "image/jpeg", "image/webp"]
        } }
      ]
    },
    {
      "id": "template-detail", "title": "Document template", "routePath": "templates/:id", "permission": "wattanam.document-designer.view",
      "parameters": [{ "name": "id", "type": "string", "maximumLength": 120 }],
      "dataSources": [
        { "id": "template", "method": "GET", "path": "templates/:id", "permission": "wattanam.document-designer.view" },
        { "id": "export-model", "method": "POST", "path": "templates/:id/export-model", "permission": "wattanam.document-designer.print" }
      ],
      "components": [{ "id": "template-detail", "type": "detail", "title": "Template", "source": "template", "fields": [
        { "label": "Name", "path": "name" }, { "label": "Document type", "path": "documentType" },
        { "label": "Active", "path": "isActive" }, { "label": "Updated", "path": "updatedAt" }
      ] },
      { "id": "generate-form", "type": "form", "title": "Generate documents", "source": "export-model", "fields": [
        { "id": "payload", "type": "json", "label": "Authorized records JSON", "required": true, "maxLength": 1048576 }
      ], "options": { "submitLabel": "Generate preview", "successMessage": "Preview generated below" } },
      { "id": "generated-export", "type": "print", "title": "Generated records", "source": "export-model", "fields": [
        { "label": "ID", "path": "id" }, { "label": "Name", "path": "name" }
      ], "options": { "itemsPath": "records", "formats": ["csv"], "filename": "generated-documents", "maximumRows": 500 } },
      { "id": "document-preview", "type": "document", "title": "Design-faithful preview", "source": "export-model", "options": { "documentsPath": "documents", "formats": ["print", "pdf"], "maximumDocuments": 500 } }]
    },
    {
      "id": "template-editor", "title": "Edit document template", "routePath": "templates/edit/:id", "permission": "wattanam.document-designer.edit",
      "parameters": [{ "name": "id", "type": "string", "maximumLength": 120 }],
      "dataSources": [
        { "id": "template", "method": "GET", "path": "templates/:id", "permission": "wattanam.document-designer.view" },
        { "id": "save-template", "method": "PATCH", "path": "templates/:id", "permission": "wattanam.document-designer.edit" },
        { "id": "assets", "method": "GET", "path": "assets", "permission": "wattanam.document-designer.view" }
      ],
      "components": [{ "id": "design-editor", "type": "designer", "title": "Visual document designer", "source": "template", "options": { "saveSource": "save-template", "assetSource": "assets", "maximumElements": 100 } }]
    }
  ]
}
