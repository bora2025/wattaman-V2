  },
  "migrations": [],
  "navigation": [
    { "id": "student-summary", "label": "Student summary reports", "href": "/plugins/wattanam.reporting/student-summaries", "permission": "wattanam.reporting.student-summary.view" },
    { "id": "staff-summary", "label": "Staff attendance summary", "href": "/plugins/wattanam.reporting/staff-summaries", "permission": "wattanam.reporting.student-summary.view" }
