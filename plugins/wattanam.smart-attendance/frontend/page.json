{
  "schemaVersion": 2,
  "kind": "declarative-ui",
  "portability": "universal",
  "pages": [
    {
      "id": "station",
      "title": "Attendance Station",
      "routePath": "station",
      "permission": "wattanam.smart-attendance.station.operate",
      "parameters": [],
      "dataSources": [
        {
          "id": "me",
          "method": "GET",
          "path": "stations/me",
          "permission": "wattanam.smart-attendance.station.operate",
          "autoload": false
        },
        {
          "id": "register",
          "method": "POST",
          "path": "stations/register",
          "permission": "wattanam.smart-attendance.station.operate"
        },
        {
          "id": "capture",
          "method": "POST",
          "path": "captures",
          "permission": "wattanam.smart-attendance.station.operate"
        },
        {
          "id": "result",
          "method": "GET",
          "path": "captures/:id",
          "permission": "wattanam.smart-attendance.station.operate",
          "autoload": false,
          "parameters": [
            "id"
          ]
        },
        {
          "id": "review",
          "method": "POST",
          "path": "captures/:id/review",
          "permission": "wattanam.smart-attendance.station.operate",
          "autoload": false,
          "parameters": [
            "id"
          ]
        }
      ],
      "components": [
        {
          "id": "attendance-station",
          "type": "app",
          "title": "Attendance Station",
          "options": {
            "entry": "ui/station/index.html",
            "height": "auto",
            "minHeight": 640,
            "devices": [
              "scanner",
              "device-id",
              "face",
              "nfc",
              "storage"
            ]
          }
        }
      ]
    },
    {
