    {
      "id": "attendance-settings",
      "title": "Attendance Settings",
      "routePath": "attendance-settings",
      "permission": "wattanam.smart-attendance.configure",
      "parameters": [],
      "dataSources": [
        {
          "id": "identifiers",
          "method": "GET",
          "path": "identifiers",
          "permission": "wattanam.academic-management.attendance.devices.manage",
          "plugin": "wattanam.academic-management"
        },
        {
          "id": "createIdentifier",
          "method": "POST",
          "path": "identifiers",
          "permission": "wattanam.academic-management.attendance.devices.manage",
          "plugin": "wattanam.academic-management"
        },
        {
          "id": "sessions",
          "method": "GET",
          "path": "sessions",
          "permission": "wattanam.academic-management.attendance.view",
          "plugin": "wattanam.academic-management"
        },
        {
          "id": "saveSession",
          "method": "POST",
          "path": "sessions",
          "permission": "wattanam.academic-management.attendance.configure",
          "plugin": "wattanam.academic-management"
        },
        {
          "id": "sessionSettings",
          "method": "GET",
          "path": "session-settings",
          "permission": "wattanam.academic-management.attendance.view",
          "plugin": "wattanam.academic-management"
        },
        {
          "id": "saveSessionSettings",
          "method": "PUT",
          "path": "session-settings",
          "permission": "wattanam.academic-management.attendance.configure",
          "plugin": "wattanam.academic-management"
        },
        {
          "id": "holidays",
          "method": "GET",
          "path": "holidays",
          "permission": "wattanam.academic-management.attendance.view",
          "plugin": "wattanam.academic-management"
        },
        {
          "id": "createHoliday",
          "method": "POST",
          "path": "holidays",
          "permission": "wattanam.academic-management.attendance.configure",
          "plugin": "wattanam.academic-management"
        },
        {
          "id": "alertRules",
          "method": "GET",
          "path": "alert-rules",
          "permission": "wattanam.academic-management.attendance.configure",
          "plugin": "wattanam.academic-management"
        },
        {
          "id": "saveAlertRule",
          "method": "POST",
          "path": "alert-rules",
          "permission": "wattanam.academic-management.attendance.configure",
          "plugin": "wattanam.academic-management"
        }
      ],
      "components": [
        {
          "id": "session-settings-workspace",
          "type": "app",
          "title": "Session Time Settings",
          "options": {
            "entry": "ui/sessions/index.html",
            "height": "auto",
            "minHeight": 400,
            "apis": [
              "wattanam.academic-management"
            ]
          }
        },
        {
          "id": "identifiers",
          "type": "table",
          "title": "Camera / card / USB identifiers",
          "source": "identifiers",
          "fields": [
            {
              "id": "code",
              "label": "Code",
              "filterable": true
            },
            {
              "id": "personType",
              "label": "Type"
            },
            {
              "id": "personId",
              "label": "Person ID"
            },
            {
              "id": "active",
              "label": "Active",
              "format": "boolean"
            }
          ],
          "options": {
            "pageSize": 20,
            "selectable": false
          }
        },
        {
          "id": "identifier-form",
          "type": "form",
          "title": "Add identifier",
          "source": "createIdentifier",
          "fields": [
            {
              "id": "code",
              "type": "text",
              "label": "Card / QR / USB code",
              "required": true
            },
            {
              "id": "personId",
              "type": "text",
              "label": "Person ID",
              "required": true
            },
            {
              "id": "personType",
              "type": "select",
              "label": "Person type",
              "required": true,
              "options": [
                {
                  "label": "Student",
                  "value": "STUDENT"
                },
                {
                  "label": "Staff",
                  "value": "STAFF"
                }
              ]
            }
          ],
          "options": {
            "submitLabel": "Add identifier",
            "successMessage": "Identifier added"
          }
        },
        {
          "id": "holidays",
          "type": "table",
          "title": "Holidays",
          "source": "holidays",
          "fields": [
            {
              "id": "date",
              "label": "Date",
              "format": "date"
            },
            {
              "id": "name",
              "label": "Name"
            },
            {
              "id": "type",
              "label": "Type"
            }
          ],
          "options": {
            "pageSize": 20,
            "selectable": false
          }
        },
        {
          "id": "holiday-form",
          "type": "form",
          "title": "Add holiday",
          "source": "createHoliday",
          "fields": [
            {
              "id": "date",
              "type": "date",
              "label": "Date",
              "required": true
            },
            {
              "id": "name",
              "type": "text",
              "label": "Name",
              "required": true
            },
            {
              "id": "description",
              "type": "textarea",
              "label": "Description"
            }
          ],
          "options": {
            "submitLabel": "Add holiday",
            "successMessage": "Holiday added"
          }
        },
        {
          "id": "alert-rules",
          "type": "table",
          "title": "Absence alert rules",
          "source": "alertRules",
          "fields": [
            {
              "id": "code",
              "label": "Code"
            },
            {
              "id": "enabled",
              "label": "Enabled",
              "format": "boolean"
            },
            {
              "id": "threshold",
              "label": "Absences"
            },
            {
              "id": "windowDays",
              "label": "Window days"
            },
            {
              "id": "channels",
              "label": "Channels"
            }
          ],
          "options": {
            "pageSize": 20,
            "selectable": false
          }
        },
        {
          "id": "alert-rule-form",
          "type": "form",
          "title": "Create or update absence alert rule",
          "source": "saveAlertRule",
          "fields": [
            {
              "id": "code",
              "type": "text",
              "label": "Rule code",
              "required": true,
              "minLength": 3,
              "maxLength": 100
            },
            {
              "id": "threshold",
              "type": "number",
              "label": "Absence threshold",
              "required": true,
              "min": 1,
              "max": 100
            },
            {
              "id": "windowDays",
              "type": "number",
              "label": "Window days",
              "required": true,
              "min": 1,
              "max": 365
            },
            {
              "id": "enabled",
              "type": "checkbox",
              "label": "Enabled"
            }
          ],
          "options": {
            "submitLabel": "Save alert rule",
            "successMessage": "Alert rule saved"
          }
        }
      ]
    },
    {
      "id": "self-windows",
      "title": "Self-Attendance Windows",
      "routePath": "self-attendance/windows",
      "permission": "wattanam.smart-attendance.self.windows",
      "parameters": [],
      "dataSources": [
        {
          "id": "windows",
          "method": "GET",
          "path": "attendance-windows",
          "permission": "wattanam.academic-management.attendance.windows.manage",
          "plugin": "wattanam.academic-management"
        },
        {
          "id": "openWindow",
          "method": "POST",
          "path": "attendance-windows",
          "permission": "wattanam.academic-management.attendance.windows.manage",
          "plugin": "wattanam.academic-management"
        },
        {
          "id": "rotateWindow",
          "method": "POST",
          "path": "attendance-windows/:id/rotate",
          "parameters": [
            "id"
          ],
          "autoload": false,
          "permission": "wattanam.academic-management.attendance.windows.manage",
          "plugin": "wattanam.academic-management"
        },
        {
          "id": "closeWindow",
          "method": "POST",
          "path": "attendance-windows/:id/close",
          "parameters": [
            "id"
          ],
          "autoload": false,
          "permission": "wattanam.academic-management.attendance.windows.manage",
          "plugin": "wattanam.academic-management"
        },
        {
          "id": "windowLive",
          "method": "GET",
          "path": "attendance-windows/:id/live",
          "parameters": [
            "id"
          ],
          "autoload": false,
          "permission": "wattanam.academic-management.attendance.windows.manage",
          "plugin": "wattanam.academic-management"
        },
        {
          "id": "windowClasses",
          "method": "GET",
          "path": "classes",
          "permission": "wattanam.academic-management.view",
          "plugin": "wattanam.academic-management"
        }
      ],
      "components": [
        {
          "id": "heading",
          "type": "heading",
          "title": "Secure student self-attendance"
        },
        {
          "id": "windows-table",
          "type": "table",
          "title": "Attendance windows and rotating QR tokens",
          "source": "windows",
          "fields": [
            {
              "id": "classId",
              "label": "Class",
              "filterable": true
            },
            {
              "id": "session",
              "label": "Session"
            },
            {
              "id": "sessionType",
              "label": "Type"
            },
            {
              "id": "status",
              "label": "Status",
              "filterable": true
            },
            {
              "id": "startsAt",
              "label": "Starts",
              "format": "datetime"
            },
            {
              "id": "endsAt",
              "label": "Ends",
              "format": "datetime"
            },
            {
              "id": "attendanceToken",
              "label": "Current signed QR token"
            },
            {
              "id": "expiresAt",
              "label": "Token expires",
              "format": "datetime"
            }
          ],
          "options": {
            "pageSize": 20,
            "selectable": false,
            "rowActions": [
              {
                "id": "rotate-window",
                "label": "Rotate QR",
                "source": "rotateWindow",
                "idField": "id",
                "idParameter": "id",
                "confirmation": "Generate a fresh short-lived QR token for this window?"
              },
              {
                "id": "close-window",
                "label": "Close",
                "source": "closeWindow",
                "idField": "id",
                "idParameter": "id",
                "confirmation": "Close this attendance window?",
                "destructive": true
              }
            ]
          }
        },
        {
          "id": "open-window-form",
          "type": "form",
          "title": "Open attendance window",
          "source": "openWindow",
          "fields": [
            {
              "id": "classId",
              "type": "text",
              "label": "Class ID",
              "required": true
            },
            {
              "id": "session",
              "type": "number",
              "label": "Session",
              "required": true,
              "min": 1,
              "max": 4
            },
            {
              "id": "sessionType",
              "type": "select",
              "label": "Action",
              "required": true,
              "options": [
                {
                  "label": "Check in",
                  "value": "CHECK_IN"
                },
                {
                  "label": "Check out",
                  "value": "CHECK_OUT"
                }
              ]
            },
            {
              "id": "startsAt",
              "type": "text",
              "label": "Starts at (ISO date/time)",
              "required": true
            },
            {
              "id": "endsAt",
              "type": "text",
              "label": "Ends at (ISO date/time)",
              "required": true
            },
            {
              "id": "qrValiditySeconds",
              "type": "number",
              "label": "QR validity seconds",
              "required": true,
              "min": 15,
              "max": 300,
              "defaultValue": 45
            },
            {
              "id": "locationRequired",
              "type": "checkbox",
              "label": "Require campus location"
            },
            {
              "id": "latitude",
              "type": "number",
              "label": "Campus latitude",
              "visibleWhen": {
                "field": "locationRequired",
                "equals": true
              }
            },
            {
              "id": "longitude",
              "type": "number",
              "label": "Campus longitude",
              "visibleWhen": {
                "field": "locationRequired",
                "equals": true
              }
            },
            {
              "id": "radiusMeters",
              "type": "number",
              "label": "Campus radius (meters)",
              "min": 10,
              "max": 10000,
              "visibleWhen": {
                "field": "locationRequired",
                "equals": true
              }
            },
            {
              "id": "maxAccuracyMeters",
              "type": "number",
              "label": "Maximum GPS accuracy (meters)",
              "min": 5,
              "max": 5000,
              "defaultValue": 100
            },
            {
              "id": "registeredDeviceRequired",
              "type": "checkbox",
              "label": "Require registered student device"
            },
            {
              "id": "maxOfflineMinutes",
              "type": "number",
              "label": "Maximum offline age (minutes)",
              "min": 0,
              "max": 10080,
              "defaultValue": 1440
            }
          ],
          "options": {
            "submitLabel": "Open and create signed QR",
            "confirmation": "Open this attendance window?",
            "successMessage": "Attendance window opened"
          }
        }
      ]
    },
    {
      "id": "self-scan",
      "title": "Scan Attendance",
      "routePath": "self-attendance/scan",
      "permission": "wattanam.smart-attendance.self.scan",
