{
  auto_https off
  admin off
}

:8080 {
  encode zstd gzip

  respond /gateway-health 200

  @socket path /socket.io/*
  handle @socket {
    reverse_proxy {$API_UPSTREAM:api:3001}
  }

  @api path /api/*
  handle @api {
    uri strip_prefix /api
    reverse_proxy {$API_UPSTREAM:api:3001}
  }

  handle {
    reverse_proxy {$WEB_UPSTREAM:web:3000}
  }
}

