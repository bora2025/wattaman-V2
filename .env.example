# Copy to .env for Docker Compose. Never commit the resulting .env file.
POSTGRES_DB=wattanam
POSTGRES_USER=wattanam
POSTGRES_PASSWORD=replace-with-a-unique-database-password
JWT_SECRET=replace-with-a-unique-secret-of-at-least-32-characters
APP_VERSION=0.1.0
APP_URL=http://localhost:3000
BACKUP_RETENTION_DAYS=30
MARKETPLACE_URL=
UPDATE_CHANNEL=stable
UPDATE_REPOSITORY_KEY_ID=official-repository-2026
PLUGIN_SAFE_MODE=false
PLUGIN_STORAGE_MAX_FILE_BYTES=1048576

# Optional notification adapters. Leave every value in an adapter unset to disable it.
# SENDGRID_API_KEY=
# SENDGRID_FROM=notifications@school.example
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=+85512345678
