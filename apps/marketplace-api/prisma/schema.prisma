generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformOperatorStatus {
  ACTIVE
  SUSPENDED
}

enum SchoolPluginRequestType {
  FREE_APPROVAL
  PURCHASE_ASSISTANCE
  PRIVATE_PLUGIN_ACCESS
  TRIAL
  FEATURE_REQUEST
}

enum SchoolPluginRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  NEEDS_INFORMATION
  APPROVED
  REJECTED
  CANCELLED
  ENTITLEMENT_ISSUED
}

enum SchoolPluginRequestDecisionType {
  ASSIGNED
  STARTED_REVIEW
  INFORMATION_REQUESTED
  INFORMATION_RECEIVED
  APPROVED
  REJECTED
  CANCELLED
  ORDER_CREATED
  ENTITLEMENT_ISSUED
}

enum SchoolPluginRequestMessageVisibility {
  CUSTOMER
  INTERNAL
}

enum SchoolPluginRequestExceptionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PublisherStatus {
  PENDING
  VERIFIED
  SUSPENDED
}

enum ReviewStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ReleaseChannel {
  STABLE
  BETA
}

enum AdvisorySeverity {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum AdvisoryAction {
  WARN
  DISABLE
  REMOVE
}

enum EntitlementStatus {
  ACTIVE
  EXPIRED
  REVOKED
  REFUNDED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum DisputeStatus {
  OPEN
  WON
  LOST
}

enum ChallengePurpose {
  REGISTER
  ROTATE
}

enum InstallationLinkStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
  DELIVERED
}

/// Where a customer school sits in its commercial life, tracked by the control plane only.
/// `AWAITING_CLAIM` means an enrollment token has been minted but no installation has presented
/// it yet, so the school exists as a sales record before any infrastructure does.
enum SchoolLifecycleStatus {
  PROSPECT
  AWAITING_CLAIM
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum SchoolInvoiceStatus {
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum SchoolBillingInterval {
  MONTHLY
  ANNUAL
}

/// Who raised an invoice. A scheduled run is not a person, and recording that as a null operator
/// alone would be ambiguous with an operator record that was later deleted.
enum SchoolInvoiceOrigin {
  OPERATOR
  SCHEDULED
}

enum SchoolInvoiceLineKind {
  SUBSCRIPTION
  PLUGIN
  ADJUSTMENT
  CREDIT
}

enum SchoolBillingNotificationType {
  INVOICE_ISSUED
  DUE_SOON
  OVERDUE
  PAYMENT_RECEIVED
}

enum SchoolBillingNotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum SchoolPaymentSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SchoolProvisioningStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PROVISIONING
  READY
  FAILED_RETRYABLE
  CANCELLED
}

enum SchoolProvisioningAttemptStatus {
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PublisherRole {
  OWNER
  ADMIN
  RELEASE_MANAGER
  FINANCE
  SUPPORT
  REVIEWER
}

enum SubmissionStatus {
  ANALYZING
  NEEDS_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ReviewDecisionType {
  APPROVE
  REJECT
}

enum RevenueEntryType {
  SALE
  REFUND
  WITHHOLDING
  CORRECTION
  PAYOUT
}

enum PayoutStatus {
  PENDING_APPROVAL
  APPROVED
  PAID
  REJECTED
}

model Publisher {
  id             String                      @id @default(uuid())
  slug           String                      @unique
  displayName    String
  status         PublisherStatus             @default(PENDING)
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  keys           PublisherKey[]
  plugins        MarketplacePlugin[]
  members        PublisherMember[]
  acceptances    PublisherPolicyAcceptance[]
  submissions    PluginSubmission[]
  revenueEntries PublisherRevenueEntry[]
  statements     PublisherStatement[]
  payouts        PublisherPayout[]
}

model MarketplaceAccount {
  id                    String                         @id @default(uuid())
  email                 String                         @unique
  displayName           String
  passwordHash          String
  emailVerifiedAt       DateTime?
  mfaEnabled            Boolean                        @default(false)
  mfaSecret             String?
  failedLoginCount      Int                            @default(0)
  lockedUntil           DateTime?
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt
  orders                MarketplaceOrder[]
  installations         InstallationRegistration[]
  marketplaceGrants     InstallationMarketplaceGrant[]
  sessions              MarketplaceSession[]
  emailVerifications    MarketplaceEmailVerification[]
  passwordResets        MarketplacePasswordReset[]
  mfaRecoveryCodes      MarketplaceMfaRecoveryCode[]
  auditEvents           MarketplaceAuditEvent[]
  publisherMemberships  PublisherMember[]
  policyAcceptances     PublisherPolicyAcceptance[]
  submissionReviews     SubmissionReview[]
  schoolPluginRequests  SchoolPluginRequest[]
  pluginRequestMessages SchoolPluginRequestMessage[]
}

model MarketplaceSession {
  id                  String              @id @default(uuid())
  accountId           String
  tokenHash           String              @unique
  scope               String              @default("FULL")
  sourceGrantId       String?
  createdAt           DateTime            @default(now())
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedBySessionId String?             @unique
  account             MarketplaceAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  replacedBy          MarketplaceSession? @relation("SessionRotation", fields: [replacedBySessionId], references: [id])
  rotatedFrom         MarketplaceSession? @relation("SessionRotation")

  @@index([accountId, revokedAt])
  @@index([sourceGrantId, revokedAt])
}

model MarketplaceEmailVerification {
  id         String             @id @default(uuid())
  accountId  String
  tokenHash  String             @unique
  createdAt  DateTime           @default(now())
  expiresAt  DateTime
  consumedAt DateTime?
  account    MarketplaceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, consumedAt])
}

model MarketplacePasswordReset {
  id         String             @id @default(uuid())
  accountId  String
  tokenHash  String             @unique
  createdAt  DateTime           @default(now())
  expiresAt  DateTime
  consumedAt DateTime?
  account    MarketplaceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, consumedAt])
}

model MarketplaceMfaRecoveryCode {
  id        String             @id @default(uuid())
  accountId String
  codeHash  String             @unique
  createdAt DateTime           @default(now())
  usedAt    DateTime?
  account   MarketplaceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, usedAt])
}

model MarketplaceAuditEvent {
  id        String              @id @default(uuid())
  accountId String?
  action    String
  success   Boolean             @default(true)
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime            @default(now())
  account   MarketplaceAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
  @@index([action, createdAt])
}

model PublisherKey {
  id           String    @id @default(uuid())
  publisherId  String
  keyId        String
  publicKeyPem String
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  enrolledBy   String?
  approvedBy   String?
  revokedBy    String?
  approvedAt   DateTime?
  publisher    Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  @@unique([publisherId, keyId])
}

model PublisherMember {
  id          String             @id @default(uuid())
  publisherId String
  accountId   String
  role        PublisherRole
  verifiedAt  DateTime?
  suspendedAt DateTime?
  createdAt   DateTime           @default(now())
  publisher   Publisher          @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  account     MarketplaceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([publisherId, accountId, role])
  @@index([accountId, suspendedAt])
}

model PublisherPolicy {
  id          String                      @id @default(uuid())
  policyKey   String
  version     String
  title       String
  bodySha256  String
  effectiveAt DateTime
  retiredAt   DateTime?
  createdAt   DateTime                    @default(now())
  acceptances PublisherPolicyAcceptance[]

  @@unique([policyKey, version])
  @@index([policyKey, effectiveAt])
}

model PublisherPolicyAcceptance {
  id          String             @id @default(uuid())
  policyId    String
  publisherId String
  accountId   String
  acceptedAt  DateTime           @default(now())
  ip          String?
  userAgent   String?
  policy      PublisherPolicy    @relation(fields: [policyId], references: [id], onDelete: Restrict)
  publisher   Publisher          @relation(fields: [publisherId], references: [id], onDelete: Restrict)
  account     MarketplaceAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([policyId, publisherId, accountId])
  @@index([publisherId, acceptedAt])
}

model MarketplacePlugin {
  id                   String                    @id
  publisherId          String
  name                 String
  description          String
  license              String
  isPaid               Boolean                   @default(false)
  status               ReviewStatus              @default(DRAFT)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  publisher            Publisher                 @relation(fields: [publisherId], references: [id])
  versions             PluginVersion[]
  advisories           SecurityAdvisory[]
  entitlements         InstallationEntitlement[]
  orderLines           MarketplaceOrderLine[]
  prices               ProductPrice[]
  schoolPluginRequests SchoolPluginRequest[]
}

model ProductPrice {
  id            String                 @id @default(uuid())
  pluginId      String
  currency      String
  amountMinor   Int
  licensedMajor Int
  validFrom     DateTime
  validUntil    DateTime?
  updatesDays   Int                    @default(365)
  licenseDays   Int                    @default(3650)
  createdAt     DateTime               @default(now())
  plugin        MarketplacePlugin      @relation(fields: [pluginId], references: [id], onDelete: Restrict)
  orderLines    MarketplaceOrderLine[]

  @@index([pluginId, currency, validFrom])
}

model PluginVersion {
  id           String            @id @default(uuid())
  pluginId     String
  version      String
  requiresCore String
  channel      ReleaseChannel    @default(STABLE)
  reviewStatus ReviewStatus      @default(DRAFT)
  manifestJson Json
  changelog    String?
  publishedAt  DateTime?
  withdrawnAt  DateTime?
  createdAt    DateTime          @default(now())
  plugin       MarketplacePlugin @relation(fields: [pluginId], references: [id])
  artifact     PackageArtifact?
  downloads    DownloadEvent[]
  reviews      VersionReview[]
  submission   PluginSubmission?

  @@unique([pluginId, version, channel])
  @@index([reviewStatus, channel, publishedAt])
}

model PluginSubmission {
  id              String             @id @default(uuid())
  publisherId     String
  pluginVersionId String             @unique
  status          SubmissionStatus   @default(ANALYZING)
  analysisReport  Json
  riskLevel       String
  submittedBy     String
  submittedAt     DateTime           @default(now())
  decidedAt       DateTime?
  publisher       Publisher          @relation(fields: [publisherId], references: [id], onDelete: Restrict)
  pluginVersion   PluginVersion      @relation(fields: [pluginVersionId], references: [id], onDelete: Restrict)
  reviews         SubmissionReview[]

  @@index([status, submittedAt])
  @@index([publisherId, submittedAt])
}

model SubmissionReview {
  id           String             @id @default(uuid())
  submissionId String
  reviewerId   String
  decision     ReviewDecisionType
  notes        String
  evidence     Json
  createdAt    DateTime           @default(now())
  submission   PluginSubmission   @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  reviewer     MarketplaceAccount @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@unique([submissionId, reviewerId])
  @@index([submissionId, decision])
}

model PackageArtifact {
  id              String        @id @default(uuid())
  pluginVersionId String        @unique
  sha256          String        @unique
  sizeBytes       Int
  storageKey      String        @unique
  publisherKeyId  String
  createdAt       DateTime      @default(now())
  pluginVersion   PluginVersion @relation(fields: [pluginVersionId], references: [id], onDelete: Restrict)
}

model SecurityAdvisory {
  id                String            @id
  pluginId          String
  title             String
  severity          AdvisorySeverity
  affectedVersions  String
  fixedVersion      String?
  description       String
  recommendedAction AdvisoryAction    @default(WARN)
  communicationUrl  String?
  publishedAt       DateTime          @default(now())
  withdrawnAt       DateTime?
  plugin            MarketplacePlugin @relation(fields: [pluginId], references: [id])

  @@index([pluginId, publishedAt])
}

/// The control plane's directory record for a customer school -- the thing an operator creates in
/// the console, which exists before any infrastructure does and outlives any single installation.
///
/// It is deliberately separate from `InstallationRegistration`: that model is the *cryptographic*
/// identity a deployment proves with its Ed25519 key, and it is created by the school, not by us.
/// A school that is rebuilt onto a fresh deployment gets a new installation and keeps this record.
///
/// Nothing here is school business data. ADR-0002 makes each school its own database, and the
/// control plane has no route into one; these are commercial facts we already hold about a
/// customer (who they are, what they bought, whether they are in good standing).
model CustomerSchool {
  id                  String                    @id @default(uuid())
  name                String
  /// Kebab-case, matching tools/provision-railway-school.js's validation so a later provisioning
  /// increment can derive a Railway project name from the same value without a second rule.
  slug                String                    @unique
  status              SchoolLifecycleStatus     @default(PROSPECT)
  region              String?
  timezone            String?
  locale              String?
  currency            String?
  plan                String?
  contactName         String?
  contactEmail        String?
  /// Populated by hand today, and by the provisioner when B-006 lands. Unique because a Railway
  /// project holds exactly one school (ADR-0002), so two directory records pointing at one project
  /// means one of them is wrong -- and the plan requires that collision to be refused, not merged.
  railwayProjectId    String?                   @unique
  gatewayOrigin       String?                   @unique
  notes               String?
  createdByOperatorId String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  suspendedAt         DateTime?
  suspendedReason     String?
  terminatedAt        DateTime?
  terminatedReason    String?
  createdBy           PlatformOperator?         @relation("CustomerSchoolCreator", fields: [createdByOperatorId], references: [id], onDelete: SetNull)
  enrollmentTokens    SchoolEnrollmentToken[]
  installation        InstallationRegistration?
  provisioningRequests SchoolProvisioningRequest[]
  domains             CustomerSchoolDomain[]
  invoices            SchoolInvoice[]
  billingPlanId       String?
  billingPlan         SchoolBillingPlan?        @relation(fields: [billingPlanId], references: [id], onDelete: SetNull)
  /// The instant the subscription renews from, set when a plan is assigned. Without it "monthly"
  /// means nothing more precise than "whenever somebody last clicked the button", and the recurring
  /// billing run has no way to say which periods it owes a school.
  billingAnchorAt     DateTime?
  billingNotifications SchoolBillingNotification[]

  @@index([status, createdAt])
}

/// Central pricing catalog for the Wattanam service itself. Invoice prices are snapshotted so a
/// later plan-price change never rewrites historical financial records.
model SchoolBillingPlan {
  id              String                @id @default(uuid())
  slug            String                @unique
  name            String
  currency        String
  amountMinor     Int
  billingInterval SchoolBillingInterval
  dueDays         Int                   @default(14)
  active          Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  schools         CustomerSchool[]
  invoices        SchoolInvoice[]
  invoiceLines    SchoolInvoiceLine[]

  @@index([active, slug])
}

/// Public hostnames assigned to a customer school. DNS and TLS are still provisioned by Railway;
/// this records the control-plane intent and verification result without storing DNS credentials.
model CustomerSchoolDomain {
  id               String         @id @default(uuid())
  customerSchoolId String
  hostname         String         @unique
  isPrimary        Boolean        @default(false)
  verifiedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  school           CustomerSchool @relation(fields: [customerSchoolId], references: [id], onDelete: Cascade)

  @@index([customerSchoolId, isPrimary])
}

/// Platform service invoices owed by a customer school. They carry the central subscription and,
/// once a plugin is bought on account rather than paid for outright, its purchase lines too -- see
/// docs/marketplace/school-billing-subscription-and-plugin-plan.md. They never contain student fees
/// or any other school operational data.
///
/// `amountMinor` is the sum of `lines`, verified in the transaction that writes them. It stays
/// stored rather than derived because the dunning sweep, the suspension gate, and the school-side
/// sync all read it on every pass.
model SchoolInvoice {
  id                  String              @id @default(uuid())
  invoiceNumber       String              @unique
  customerSchoolId    String
  status              SchoolInvoiceStatus @default(ISSUED)
  currency            String
  amountMinor         Int
  paidMinor           Int                 @default(0)
  description         String
  periodStart         DateTime?
  periodEnd           DateTime?
  dueAt               DateTime
  issuedAt            DateTime            @default(now())
  paidAt              DateTime?
  voidedAt            DateTime?
  voidReason           String?
  idempotencyKey      String              @unique
  /// Null when the recurring billing run raised this invoice; see `origin`.
  createdByOperatorId String?
  origin              SchoolInvoiceOrigin @default(OPERATOR)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  school              CustomerSchool      @relation(fields: [customerSchoolId], references: [id], onDelete: Restrict)
  createdBy           PlatformOperator?   @relation("SchoolInvoiceCreator", fields: [createdByOperatorId], references: [id], onDelete: Restrict)
  payments            SchoolPayment[]
  billingPlanId       String?
  billingPlanSlug     String?
  billingPlan         SchoolBillingPlan? @relation(fields: [billingPlanId], references: [id], onDelete: SetNull)
  notifications       SchoolBillingNotification[]
  paymentSubmissions  SchoolPaymentSubmission[]
  lines               SchoolInvoiceLine[]

  /// Identifies the plan period this invoice covers, so the database refuses a second invoice for
  /// the same one -- deduplication used to rest entirely on a client-generated idempotency key, and
  /// the console mints a fresh one per click, so double-clicking billed a school twice for one
  /// month with two independent suspension clocks. Null for one-off invoices, and set back to null
  /// when an invoice is voided, which frees the period to be billed again.
  periodKey           String?

  @@unique([customerSchoolId, periodKey])
  @@index([customerSchoolId, issuedAt])
  @@index([status, dueAt])
}

/// One chargeable item on a school invoice. Lines are immutable once written: corrections are
/// further lines (ADJUSTMENT, CREDIT) or a void and reissue, never an edit, so an invoice a
/// customer has already received cannot change value underneath them.
model SchoolInvoiceLine {
  id                String                @id @default(uuid())
  invoiceId         String
  position          Int
  kind              SchoolInvoiceLineKind
  description       String
  quantity          Int                   @default(1)
  unitAmountMinor   Int
  amountMinor       Int
  /// Reserved for VAT. Nothing computes it yet; it exists from the first version because adding a
  /// tax column to invoices customers have already received is far more expensive than carrying it.
  taxMinor          Int                   @default(0)
  periodStart       DateTime?
  periodEnd         DateTime?
  billingPlanId     String?
  sourceOrderLineId String?               @unique
  createdAt         DateTime              @default(now())
  invoice           SchoolInvoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  billingPlan       SchoolBillingPlan?    @relation(fields: [billingPlanId], references: [id], onDelete: SetNull)
  sourceOrderLine   MarketplaceOrderLine? @relation(fields: [sourceOrderLineId], references: [id], onDelete: Restrict)

  @@unique([invoiceId, position])
  @@index([invoiceId])
}

/// Customer-declared payment evidence. It never changes invoice balances until a finance
/// operator verifies and approves it, preserving the payment ledger as the source of truth.
model SchoolPaymentSubmission {
  id                   String                        @id @default(uuid())
  invoiceId            String
  accountId            String
  provider              String
  providerReference     String
  amountMinor           Int
  note                  String?
  status                SchoolPaymentSubmissionStatus @default(PENDING)
  reviewedByOperatorId String?
  reviewedAt            DateTime?
  rejectionReason       String?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  invoice               SchoolInvoice                 @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([accountId, provider, providerReference])
  @@index([invoiceId, status, createdAt])
}

model SchoolBillingNotification {
  id               String                          @id @default(uuid())
  customerSchoolId String
  invoiceId        String
  type             SchoolBillingNotificationType
  status           SchoolBillingNotificationStatus @default(PENDING)
  recipientEmail   String?
  subject          String
  message          String
  deduplicationKey String                          @unique
  attemptedAt      DateTime?
  sentAt           DateTime?
  failureMessage   String?
  createdAt        DateTime                        @default(now())
  school           CustomerSchool                  @relation(fields: [customerSchoolId], references: [id], onDelete: Restrict)
  invoice          SchoolInvoice                    @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([customerSchoolId, createdAt])
}

/// Append-only evidence of money received for a school invoice. Provider references make retries
/// idempotent; corrections use explicit future reversal records rather than editing history.
model SchoolPayment {
  id                   String           @id @default(uuid())
  invoiceId            String
  provider             String
  providerReference    String
  amountMinor          Int
  receivedAt           DateTime
  note                 String?
  recordedByOperatorId String
  createdAt            DateTime         @default(now())
  invoice              SchoolInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  recordedBy           PlatformOperator @relation("SchoolPaymentRecorder", fields: [recordedByOperatorId], references: [id], onDelete: Restrict)

  @@unique([provider, providerReference])
  @@index([invoiceId, receivedAt])
}

model SchoolProvisioningRequest {
  id                       String                   @id @default(uuid())
  customerSchoolId         String
    idempotencyKey           String                   @unique
    requestFingerprint       String
  status                   SchoolProvisioningStatus @default(DRAFT)
  targetWorkspaceId        String
  environment              String                   @default("production")
  region                   String?
  releaseVersion           String
  apiImage                  String
  webImage                  String
  gatewayImage              String
  requestedDomain          String?
  requestedByOperatorId    String
  approvedByOperatorId     String?
  internalReason           String
  submittedAt              DateTime?
  approvedAt               DateTime?
  approvalExpiresAt        DateTime?
  cancelledAt              DateTime?
  completedAt              DateTime?
  lastSuccessfulCheckpoint String?
  lastErrorCode            String?
  lastErrorMessage         String?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  school                   CustomerSchool           @relation(fields: [customerSchoolId], references: [id], onDelete: Restrict)
  requestedBy              PlatformOperator         @relation("SchoolProvisioningRequester", fields: [requestedByOperatorId], references: [id], onDelete: Restrict)
  approvedBy               PlatformOperator?        @relation("SchoolProvisioningApprover", fields: [approvedByOperatorId], references: [id], onDelete: Restrict)
  attempts                 SchoolProvisioningAttempt[]

  @@index([status, createdAt])
  @@index([customerSchoolId, createdAt])
}

model SchoolProvisioningAttempt {
  id             String                           @id @default(uuid())
  requestId      String
  attemptNumber  Int
  status         SchoolProvisioningAttemptStatus  @default(RUNNING)
  workerId       String?
  startedAt      DateTime                         @default(now())
  finishedAt     DateTime?
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime                         @default(now())
  request        SchoolProvisioningRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, attemptNumber])
  @@index([status, createdAt])
}

/// A one-time secret an operator hands to whoever deploys a school, which that deployment presents
/// at registration to prove it is the school we meant.
///
/// Only the hash is stored, exactly as `MarketplaceSession` and the school core's
/// `PasswordResetToken` do: a leaked control-plane database backup must not yield a usable token.
model SchoolEnrollmentToken {
  id                    String            @id @default(uuid())
  customerSchoolId      String
  tokenHash             String            @unique
  createdByOperatorId   String?
  createdAt             DateTime          @default(now())
  expiresAt             DateTime
  consumedAt            DateTime?
  /// The installation UUID that redeemed it, kept even after consumption so a disputed
  /// registration can be traced back to the token and the operator who minted it.
  consumedByInstallationId String?
  revokedAt             DateTime?
  school                CustomerSchool    @relation(fields: [customerSchoolId], references: [id], onDelete: Cascade)
  createdBy             PlatformOperator? @relation("SchoolEnrollmentTokenCreator", fields: [createdByOperatorId], references: [id], onDelete: SetNull)

  @@index([customerSchoolId, consumedAt, expiresAt])
}

model InstallationRegistration {
  id               String                                @id @default(uuid())
  installationId   String                                @unique
  accountId        String?
  label            String?
  lastSeenAt       DateTime?
  createdAt        DateTime                              @default(now())
  /// Nullable because every installation registered before the directory existed, and because a
  /// self-hosted school may never be claimed. Unique so one directory record cannot silently
  /// describe two deployments.
  customerSchoolId String?                               @unique
  account          MarketplaceAccount?                   @relation(fields: [accountId], references: [id])
  school           CustomerSchool?                       @relation(fields: [customerSchoolId], references: [id], onDelete: SetNull)
  keys             InstallationRegistrationKey[]
  entitlements     InstallationEntitlement[]
  downloads        DownloadEvent[]
  orders           MarketplaceOrder[]
  grantRequests    InstallationMarketplaceGrantRequest[]
  grant            InstallationMarketplaceGrant?
  pluginRequests   SchoolPluginRequest[]
}

model InstallationRegistrationKey {
  id                         String                   @id @default(uuid())
  installationRegistrationId String
  keyFingerprint             String
  publicKeyPem               String
  createdAt                  DateTime                 @default(now())
  revokedAt                  DateTime?
  installation               InstallationRegistration @relation(fields: [installationRegistrationId], references: [id], onDelete: Cascade)

  @@unique([installationRegistrationId, keyFingerprint])
  @@index([installationRegistrationId, revokedAt])
}

model InstallationRegistrationChallenge {
  id             String           @id @default(uuid())
  installationId String
  nonce          String
  purpose        ChallengePurpose
  createdAt      DateTime         @default(now())
  expiresAt      DateTime
  consumedAt     DateTime?

  @@index([installationId, purpose, consumedAt, expiresAt])
}

model InstallationMarketplaceGrantRequest {
  id                         String                        @id @default(uuid())
  installationRegistrationId String
  requestedScope             String
  status                     InstallationLinkStatus        @default(PENDING)
  createdAt                  DateTime                      @default(now())
  expiresAt                  DateTime
  respondedAt                DateTime?
  deliveredAt                DateTime?
  grantId                    String?
  installation               InstallationRegistration      @relation(fields: [installationRegistrationId], references: [id], onDelete: Cascade)
  grant                      InstallationMarketplaceGrant? @relation(fields: [grantId], references: [id])

  @@index([installationRegistrationId, status, expiresAt])
  @@index([grantId])
}

model InstallationMarketplaceGrant {
  id                         String                                @id @default(uuid())
  installationRegistrationId String                                @unique
  accountId                  String
  scope                      String
  consentedAt                DateTime
  createdAt                  DateTime                              @default(now())
  expiresAt                  DateTime
  revokedAt                  DateTime?
  revokedReason              String?
  installation               InstallationRegistration              @relation(fields: [installationRegistrationId], references: [id])
  account                    MarketplaceAccount                    @relation(fields: [accountId], references: [id])
  requests                   InstallationMarketplaceGrantRequest[]

  @@index([accountId, revokedAt])
}

model InstallationEntitlement {
  id             String                   @id @default(uuid())
  installationId String
  pluginId       String
  status         EntitlementStatus        @default(ACTIVE)
  expiresAt      DateTime?
  updatesThrough DateTime?
  offlineUntil   DateTime?
  revokedAt      DateTime?
  revokedReason  String?
  tokenId        String                   @unique
  signedToken    Json
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  installation   InstallationRegistration @relation(fields: [installationId], references: [id])
  plugin         MarketplacePlugin        @relation(fields: [pluginId], references: [id])
  orderLineId    String?                  @unique
  orderLine      MarketplaceOrderLine?    @relation(fields: [orderLineId], references: [id])
  pluginRequest  SchoolPluginRequest?

  @@unique([installationId, pluginId])
  @@index([status, expiresAt])
}

model DownloadEvent {
  id              String                    @id @default(uuid())
  installationId  String?
  pluginVersionId String
  artifactSha256  String
  downloadedAt    DateTime                  @default(now())
  installation    InstallationRegistration? @relation(fields: [installationId], references: [id])
  pluginVersion   PluginVersion             @relation(fields: [pluginVersionId], references: [id])

  @@index([pluginVersionId, downloadedAt])
}

model MarketplaceOrder {
  id             String                   @id @default(uuid())
  accountId      String
  installationId String
  status         OrderStatus              @default(PENDING)
  currency       String
  totalMinor     Int
  idempotencyKey String                   @unique
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  account        MarketplaceAccount       @relation(fields: [accountId], references: [id])
  installation   InstallationRegistration @relation(fields: [installationId], references: [id])
  lines          MarketplaceOrderLine[]
  payments       MarketplacePayment[]
  refunds        MarketplaceRefund[]
  pluginRequest  SchoolPluginRequest?

  @@index([installationId, createdAt])
}

model MarketplaceOrderLine {
  id             String                   @id @default(uuid())
  orderId        String
  pluginId       String
  priceId        String
  unitPriceMinor Int
  updatesThrough DateTime?
  order          MarketplaceOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  plugin         MarketplacePlugin        @relation(fields: [pluginId], references: [id])
  price          ProductPrice             @relation(fields: [priceId], references: [id], onDelete: Restrict)
  entitlement    InstallationEntitlement?
  revenueEntries PublisherRevenueEntry[]
  invoiceLine    SchoolInvoiceLine?
}

model MarketplacePayment {
  id          String                      @id @default(uuid())
  orderId     String
  provider    String
  providerRef String
  status      PaymentStatus               @default(PENDING)
  amountMinor Int
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  order       MarketplaceOrder            @relation(fields: [orderId], references: [id])
  refund      MarketplaceRefund?
  disputes    MarketplacePaymentDispute[]

  @@unique([provider, providerRef])
}

model MarketplaceRefund {
  id             String                  @id @default(uuid())
  orderId        String
  paymentId      String                  @unique
  amountMinor    Int
  reason         String
  initiatedBy    String
  createdAt      DateTime                @default(now())
  order          MarketplaceOrder        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment        MarketplacePayment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  revenueEntries PublisherRevenueEntry[]

  @@index([orderId])
}

model PublisherRevenueEntry {
  id             String                   @id @default(uuid())
  publisherId    String
  orderLineId    String?
  refundId       String?
  type           RevenueEntryType
  currency       String
  grossMinor     Int
  feeMinor       Int
  taxMinor       Int
  netMinor       Int
  description    String
  correctionOfId String?
  createdBy      String
  approvedBy     String?
  createdAt      DateTime                 @default(now())
  approvedAt     DateTime?
  publisher      Publisher                @relation(fields: [publisherId], references: [id], onDelete: Restrict)
  orderLine      MarketplaceOrderLine?    @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  refund         MarketplaceRefund?       @relation(fields: [refundId], references: [id], onDelete: Restrict)
  correctionOf   PublisherRevenueEntry?   @relation("RevenueCorrection", fields: [correctionOfId], references: [id], onDelete: Restrict)
  corrections    PublisherRevenueEntry[]  @relation("RevenueCorrection")
  statementLines PublisherStatementLine[]
  payoutLines    PublisherPayoutLine[]

  @@unique([orderLineId, type])
  @@index([publisherId, currency, createdAt])
  @@index([orderLineId, type])
}

model PublisherStatement {
  id          String                   @id @default(uuid())
  publisherId String
  currency    String
  periodStart DateTime
  periodEnd   DateTime
  grossMinor  Int
  feeMinor    Int
  taxMinor    Int
  netMinor    Int
  generatedAt DateTime                 @default(now())
  publisher   Publisher                @relation(fields: [publisherId], references: [id], onDelete: Restrict)
  lines       PublisherStatementLine[]

  @@unique([publisherId, currency, periodStart, periodEnd])
}

model PublisherStatementLine {
  statementId String
  entryId     String
  statement   PublisherStatement    @relation(fields: [statementId], references: [id], onDelete: Restrict)
  entry       PublisherRevenueEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)

  @@id([statementId, entryId])
  @@unique([entryId])
}

model PublisherPayout {
  id                String                @id @default(uuid())
  publisherId       String
  currency          String
  amountMinor       Int
  status            PayoutStatus          @default(PENDING_APPROVAL)
  providerReference String?
  requestedBy       String
  approvedBy        String?
  paidBy            String?
  requestedAt       DateTime              @default(now())
  approvedAt        DateTime?
  paidAt            DateTime?
  publisher         Publisher             @relation(fields: [publisherId], references: [id], onDelete: Restrict)
  lines             PublisherPayoutLine[]

  @@index([publisherId, status, requestedAt])
}

model PublisherPayoutLine {
  payoutId String
  entryId  String
  payout   PublisherPayout       @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  entry    PublisherRevenueEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)

  @@id([payoutId, entryId])
  @@unique([entryId])
}

model MarketplacePaymentDispute {
  id                 String             @id @default(uuid())
  paymentId          String
  providerDisputeRef String
  status             DisputeStatus      @default(OPEN)
  reason             String?
  openedAt           DateTime           @default(now())
  resolvedAt         DateTime?
  payment            MarketplacePayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([paymentId, providerDisputeRef])
}

model PaymentWebhookEvent {
  id          String    @id @default(uuid())
  provider    String
  eventId     String
  payloadHash String
  rawPayload  String
  signature   String
  eventType   String
  orderId     String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, eventId])
  @@index([orderId, receivedAt])
}

model VersionReview {
  id              String        @id @default(uuid())
  pluginVersionId String
  status          ReviewStatus  @default(IN_REVIEW)
  reviewer        String?
  notes           String?
  submittedAt     DateTime      @default(now())
  reviewedAt      DateTime?
  pluginVersion   PluginVersion @relation(fields: [pluginVersionId], references: [id])

  @@index([status, submittedAt])
}

model CoreRelease {
  id             String         @id @default(uuid())
  version        String
  channel        ReleaseChannel @default(STABLE)
  nodeRange      String
  postgresRange  String
  apiImage       String
  webImage       String
  gatewayImage   String
  releaseNotes   String
  migrationNotes String?
  publishedAt    DateTime       @default(now())
  withdrawnAt    DateTime?

  @@unique([version, channel])
  @@index([channel, publishedAt])
}

// ─── Platform Admin (PA-1): operator identity, RBAC, sessions, audit ───────
// See docs/marketplace/platform-admin-interface-plan.md and
// docs/marketplace/platform-admin-interface-checklist.md. Deliberately reuses
// this file's existing identity primitives (scrypt password hashing, TOTP MFA,
// opaque rotating sessions) rather than introducing a second hashing/session
// scheme -- operators are a distinct identity type from MarketplaceAccount,
// not a shared one, per the plan's boundary rules.

model PlatformOperator {
  id                        String                                 @id @default(uuid())
  email                     String                                 @unique
  displayName               String
  passwordHash              String
  status                    PlatformOperatorStatus                 @default(ACTIVE)
  mfaEnabled                Boolean                                @default(false)
  mfaSecret                 String?
  failedLoginCount          Int                                    @default(0)
  lockedUntil               DateTime?
  createdAt                 DateTime                               @default(now())
  updatedAt                 DateTime                               @updatedAt
  roles                     PlatformOperatorRole[]
  sessions                  PlatformOperatorSession[]
  mfaRecoveryCodes          PlatformOperatorMfaRecoveryCode[]
  auditEvents               PlatformAuditEvent[]
  assignedPluginRequests    SchoolPluginRequest[]
  pluginRequestDecisions    SchoolPluginRequestDecision[]
  pluginRequestMessages     SchoolPluginRequestMessage[]
  requestedPluginExceptions SchoolPluginRequestExceptionApproval[] @relation("PluginExceptionRequester")
  decidedPluginExceptions   SchoolPluginRequestExceptionApproval[] @relation("PluginExceptionDecider")
  createdCustomerSchools    CustomerSchool[]                       @relation("CustomerSchoolCreator")
  createdSchoolInvoices     SchoolInvoice[]                        @relation("SchoolInvoiceCreator")
  recordedSchoolPayments    SchoolPayment[]                        @relation("SchoolPaymentRecorder")
  mintedEnrollmentTokens    SchoolEnrollmentToken[]                @relation("SchoolEnrollmentTokenCreator")
  requestedSchoolProvisioning SchoolProvisioningRequest[]           @relation("SchoolProvisioningRequester")
  approvedSchoolProvisioning  SchoolProvisioningRequest[]           @relation("SchoolProvisioningApprover")
}

// ─── Platform Admin (PA-3): school plugin-request workflow ───────────────

model SchoolPluginRequest {
  id                 String                                @id @default(uuid())
  accountId          String
  installationId     String
  pluginId           String?
  type               SchoolPluginRequestType
  status             SchoolPluginRequestStatus             @default(SUBMITTED)
  justification      String
  intendedUsers      Int?
  desiredAt          DateTime?
  contactEmail       String
  featureDescription String?
  slaDueAt           DateTime
  assignedOperatorId String?
  orderId            String?                               @unique
  entitlementId      String?                               @unique
  submittedAt        DateTime                              @default(now())
  decidedAt          DateTime?
  fulfilledAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime                              @default(now())
  updatedAt          DateTime                              @updatedAt
  account            MarketplaceAccount                    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  installation       InstallationRegistration              @relation(fields: [installationId], references: [id], onDelete: Restrict)
  plugin             MarketplacePlugin?                    @relation(fields: [pluginId], references: [id], onDelete: Restrict)
  assignedOperator   PlatformOperator?                     @relation(fields: [assignedOperatorId], references: [id], onDelete: SetNull)
  order              MarketplaceOrder?                     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  entitlement        InstallationEntitlement?              @relation(fields: [entitlementId], references: [id], onDelete: Restrict)
  decisions          SchoolPluginRequestDecision[]
  messages           SchoolPluginRequestMessage[]
  exceptionApproval  SchoolPluginRequestExceptionApproval?

  @@index([status, slaDueAt])
  @@index([accountId, submittedAt])
  @@index([installationId, pluginId, type])
  @@index([assignedOperatorId, status])
}

model SchoolPluginRequestExceptionApproval {
  id                     String                             @id @default(uuid())
  requestId              String                             @unique
  requestedByOperatorId  String
  decidedByOperatorId    String?
  status                 SchoolPluginRequestExceptionStatus @default(PENDING)
  validityDays           Int
  reason                 String
  publicMessage          String?
  requestIdempotencyKey  String                             @unique
  decisionIdempotencyKey String?                            @unique
  requestedAt            DateTime                           @default(now())
  decidedAt              DateTime?
  request                SchoolPluginRequest                @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestedBy            PlatformOperator                   @relation("PluginExceptionRequester", fields: [requestedByOperatorId], references: [id], onDelete: Restrict)
  decidedBy              PlatformOperator?                  @relation("PluginExceptionDecider", fields: [decidedByOperatorId], references: [id], onDelete: Restrict)

  @@index([status, requestedAt])
  @@index([requestedByOperatorId, status])
}

model SchoolPluginRequestDecision {
  id             String                          @id @default(uuid())
  requestId      String
  operatorId     String
  decision       SchoolPluginRequestDecisionType
  publicMessage  String?
  internalReason String?
  conditions     Json?
  idempotencyKey String                          @unique
  createdAt      DateTime                        @default(now())
  request        SchoolPluginRequest             @relation(fields: [requestId], references: [id], onDelete: Cascade)
  operator       PlatformOperator                @relation(fields: [operatorId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@index([operatorId, createdAt])
}

model SchoolPluginRequestMessage {
  id               String                               @id @default(uuid())
  requestId        String
  visibility       SchoolPluginRequestMessageVisibility
  body             String
  accountAuthorId  String?
  operatorAuthorId String?
  idempotencyKey   String?                              @unique
  createdAt        DateTime                             @default(now())
  request          SchoolPluginRequest                  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  accountAuthor    MarketplaceAccount?                  @relation(fields: [accountAuthorId], references: [id], onDelete: Restrict)
  operatorAuthor   PlatformOperator?                    @relation(fields: [operatorAuthorId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
}

model PlatformRole {
  id            String                   @id @default(uuid())
  key           String                   @unique
  displayName   String
  description   String
  createdAt     DateTime                 @default(now())
  permissions   PlatformRolePermission[]
  operatorRoles PlatformOperatorRole[]
}

model PlatformPermission {
  id              String                   @id @default(uuid())
  key             String                   @unique
  description     String
  rolePermissions PlatformRolePermission[]
}

model PlatformRolePermission {
  roleId       String
  permissionId String
  role         PlatformRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   PlatformPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model PlatformOperatorRole {
  id         String           @id @default(uuid())
  operatorId String
  roleId     String
  grantedBy  String?
  createdAt  DateTime         @default(now())
  expiresAt  DateTime?
  operator   PlatformOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  role       PlatformRole     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([operatorId, roleId])
}

model PlatformOperatorSession {
  id                  String                   @id @default(uuid())
  operatorId          String
  tokenHash           String                   @unique
  mfaVerified         Boolean                  @default(false)
  createdAt           DateTime                 @default(now())
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedBySessionId String?                  @unique
  ip                  String?
  userAgent           String?
  operator            PlatformOperator         @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  replacedBy          PlatformOperatorSession? @relation("PlatformSessionRotation", fields: [replacedBySessionId], references: [id])
  rotatedFrom         PlatformOperatorSession? @relation("PlatformSessionRotation")

  @@index([operatorId, revokedAt])
}

model PlatformOperatorMfaRecoveryCode {
  id         String           @id @default(uuid())
  operatorId String
  codeHash   String           @unique
  createdAt  DateTime         @default(now())
  usedAt     DateTime?
  operator   PlatformOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
}

model PlatformAuditEvent {
  id            String            @id @default(uuid())
  operatorId    String?
  action        String
  success       Boolean           @default(true)
  targetType    String?
  targetId      String?
  metadata      Json?
  reason        String?
  correlationId String?
  ip            String?
  userAgent     String?
  createdAt     DateTime          @default(now())
  operator      PlatformOperator? @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([operatorId, createdAt])
  @@index([action, createdAt])
}
