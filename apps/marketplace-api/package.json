{
  "name": "@wattanam/marketplace-api",
  "version": "0.1.0",
  "private": true,
  "description": "Independent official update repository and marketplace API for Wattanam V2",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "test": "jest --runInBand",
    "drill:artifact-s3": "tsx scripts/artifact-s3-live-drill.ts",
    "certify:commerce-offline": "tsx scripts/commerce-offline-certification.ts",
    "certify:starter-bundles:postgres": "tsx scripts/starter-bundle-postgres-certification.ts",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@wattanam/marketplace-contracts": "file:../../packages/marketplace-contracts",
    "@aws-sdk/client-s3": "^3.1121.0",
    "@prisma/client": "^5.22.0",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "multer": "^2.3.0",
    "prom-client": "^15.1.3",
    "semver": "^7.8.5",
    "yauzl": "^3.4.0",
    "zod": "^3.25.76"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.19.11",
    "@types/semver": "^7.7.0",
    "@types/supertest": "^6.0.3",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.0",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "yazl": "^3.3.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ]
  }
}
