NODE_ENV=production
PORT=3010
DATABASE_URL=postgresql://wattanam_marketplace:change-me@postgres:5432/wattanam_marketplace
PUBLIC_BASE_URL=https://marketplace.wattanam.example
MARKETPLACE_ADMIN_TOKEN=replace-with-at-least-32-random-characters
METADATA_SIGNING_PRIVATE_KEY_FILE=/run/secrets/repository-signing-private.pem
# Railway alternative: set METADATA_SIGNING_PRIVATE_KEY to the multiline PEM secret.
# METADATA_SIGNING_PRIVATE_KEY=
METADATA_SIGNING_KEY_ID=official-repository-2026
ENTITLEMENT_SIGNING_PRIVATE_KEY_FILE=/run/secrets/entitlement-signing-private.pem
# Railway alternative: set ENTITLEMENT_SIGNING_PRIVATE_KEY to a distinct multiline PEM secret.
# ENTITLEMENT_SIGNING_PRIVATE_KEY=
ENTITLEMENT_SIGNING_KEY_ID=official-entitlements-2026
ARTIFACT_STORAGE_PATH=/data/artifacts
MAX_ARTIFACT_BYTES=52428800
